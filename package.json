{
  "name": "moolresha-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "MoolResha — Closer to the Root. Education-first textile knowledge site.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "tsx scripts/gen-allow-lists.ts && astro build && tsx scripts/content-check.ts && tsx scripts/js-budget.ts && tsx scripts/link-check.ts && tsx scripts/launch-gate.ts",
    "build:local": "tsx scripts/gen-allow-lists.ts && astro build && tsx scripts/js-budget.ts && tsx scripts/link-check.ts",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit -p functions",
    "brand-images": "node scripts/brand-images.mjs",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.5",
    "echarts": "^6.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@fast-check/vitest": "^0.5.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "node-html-parser": "^9.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
