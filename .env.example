# Copy to .env for local dev. NEVER commit real values — .env is gitignored.
# These power the thin dynamic layer (likes / newsletter / comments).

# Cloudflare Turnstile (bot protection for comments + newsletter). Free.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter provider (MailerLite free tier). Set when the newsletter increment ships.
MAILERLITE_API_KEY=

# GA4 (analytics increment)
PUBLIC_GA4_ID=
