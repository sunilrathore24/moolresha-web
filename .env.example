# Copy to .env for local dev. NEVER commit real values — .env is gitignored.
# These power the thin dynamic layer (likes / newsletter / comments).

# Cloudflare Turnstile (bot protection for comments + newsletter). Free.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter provider (MailerLite free tier). Set when the newsletter increment ships.
MAILERLITE_API_KEY=

# No analytics env var needed: this site uses Cloudflare Web Analytics, enabled per-zone in
# the Cloudflare dashboard (Analytics & Logs > Web Analytics), not a script-based tool like
# GA4 — so there is nothing to configure here.
