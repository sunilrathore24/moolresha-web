# --- Automated daily pipeline (free tier): GitHub Actions calls the Worker, never Meta/OpenAI directly ---
# Base URL of the deployed Worker. Not a secret.
CONTENT_STUDIO_BASE_URL=https://moolresha-content-studio.sunilrathore24.workers.dev
# Bearer key the Worker checks on /jobs/pending, /generate, /media and /publish.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# then `npx wrangler secret put EXECUTOR_KEY` and store the same value as the
# GitHub Actions secret CONTENT_STUDIO_EXECUTOR_KEY. Never commit it.
CONTENT_STUDIO_EXECUTOR_KEY=

# --- Manual/local-only tools, NOT used by the automated pipeline above ---
# ai.mjs's OpenAI path is an optional manual alternative to the Worker's free
# Workers AI generation (cloudflare/src/generate.mjs). Costs money; leave unset
# unless you deliberately want to test with it locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# automation/cli.mjs publish's direct-Meta-credentials path, for manual testing
# only; the automated pipeline publishes through the Worker instead (it never
# sees the raw token).
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0
ENABLE_INSTAGRAM_PUBLISH=false
