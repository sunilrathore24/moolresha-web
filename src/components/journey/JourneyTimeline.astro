---
/**
 * Vertical journey timeline for `/journey` (replaces the earlier two-up serpentine layout,
 * per the user's reference image, 2026-11): a horizontal 01-08 "stepper" strip, then a single
 * column of stage rows — a small thumbnail photo on the left threaded by one continuous
 * vertical rail, a small number tile + title + a short fact preview on the right.
 *
 * Source_Link (2026-11 revision): no "Read more" toggle — when a stage's fact has a real
 * cited source (label FACT/INDUSTRY CLAIM/BRAND CLAIM), its Claim_Label + Source_Link are
 * always visible, right under the preview. When it doesn't (label "MoolResha estimate" — a
 * generic process description with no cited source, e.g. field/ginning/weaving/processing),
 * nothing extra is shown at all: no Claim_Label, no "not a cited source" hedge, nothing — per
 * explicit instruction, we don't call out the absence of a source, we just don't show one.
 *
 * The visible preview and the real DOM order are the same 1-to-8 sequence; there is no visual
 * reordering here (unlike the old serpentine), so there is nothing to keep separate from
 * reading/tab order.
 *
 * Content stays exactly what it was: each stage's own Fact_Registry entry
 * (`src/content/facts/journey-*.yaml`), unchanged. A few of these facts (spinning, stitching,
 * warehousing-distribution, retail) read as tangential to what literally happens at that
 * stage — that's pre-existing content, not something changed here; flagged separately rather
 * than silently rewritten.
 *
 * The 01-08 stepper strip is a real in-page nav: each dot is an <a href="#stage-NN">, not a
 * decorative-only element, so it is a genuine quick-jump, not just a visual flourish.
 */
import { Picture } from 'astro:assets';
import ClaimLabel from '../launch/ClaimLabel.astro';
import SourceLink from '../launch/SourceLink.astro';
import { getFact, factViewModel } from '../../lib/facts';
import { JOURNEY_STOPS } from '../../lib/journey-stops';
import { imageFocus, journeyImage, pictureWidths } from '../../lib/journey-images';

const stops = JOURNEY_STOPS;
const facts = await Promise.all(stops.map((s) => getFact(s.factIds[0] as string).then(factViewModel)));
const pad = (n: number) => String(n).padStart(2, '0');
const stageId = (n: number) => `stage-${pad(n)}`;
---

<nav class="stepper" aria-label="Jump to a stage">
  <ol class="stepper-list">
    {
      stops.map((stop, i) => (
        <li class="stepper-item">
          <a class="stepper-dot" href={`#${stageId(i + 1)}`} aria-current={i === 0 ? 'step' : undefined}>
            <span class="stepper-num" aria-hidden="true">{pad(i + 1)}</span>
            <span class="visually-hidden">Jump to stage {i + 1}: {stop.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<ol class="timeline" aria-label="Stages of the cotton-to-garment journey, in order">
  {
    stops.map((stop, i) => {
      const fact = facts[i]!;
      const meta = stop.image ? journeyImage(stop.image.key) : undefined;
      return (
        <li class="stage" id={stageId(i + 1)}>
          <div class="stage-rail">
            <div class="stage-thumb">
              {stop.image && meta ? (
                <Picture
                  src={meta}
                  alt={stop.image.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={pictureWidths(meta, [96, 152, 228])}
                  sizes="76px"
                  width={meta.width}
                  height={meta.height}
                  loading="lazy"
                  decoding="async"
                  class="stage-img"
                  style={`object-position: ${imageFocus(stop.image.key)}`}
                />
              ) : (
                <div class="stage-placeholder" role="img" aria-label={`Image coming soon: ${stop.label}`} />
              )}
            </div>
          </div>
          <div class="stage-body">
            <span class="stage-num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="stage-title">{stop.label}</h3>
            <p class="stage-preview">
              {/* The source (when there is one) shares the same .fact span as the preview text
                 itself — like FactText.astro nests ClaimLabel/SourceLink inside its own .fact
                 span — so a source's date is part of that fact's own attribution, not a
                 free-standing year (Content_Check CC-09). */}
              <span class="fact" data-fact-id={fact.id}>
                {fact.text}
                {'sourceLink' in fact && (
                  <>
                    {' '}
                    <ClaimLabel label={fact.label} /> <SourceLink link={fact.sourceLink} />
                  </>
                )}
              </span>
            </p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* ---- Stepper: a real quick-jump nav, not decoration. ---- */
  .stepper {
    margin-bottom: var(--space-8);
    overflow-x: auto;
  }

  .stepper-list {
    position: relative;
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0 var(--space-1);
    list-style: none;
  }

  .stepper-list::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    left: var(--space-4);
    right: var(--space-4);
    height: 1px;
    background: var(--color-border);
  }

  .stepper-item {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .stepper-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    min-width: 2.5rem;
    min-height: 44px;
    padding-top: var(--space-1);
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .stepper-dot::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--c-raw-umber);
  }

  .stepper-dot[aria-current='step']::before {
    background: var(--color-olive, #3b3a2b);
    border-color: var(--color-olive, #3b3a2b);
  }

  .stepper-num {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .stepper-dot[aria-current='step'] .stepper-num {
    color: var(--color-accent-text);
    font-weight: 700;
  }

  .stepper-dot:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

  /* ---- Timeline: one continuous rail through the thumbnails, content to the right. ---- */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    column-gap: var(--space-4);
  }

  .stage-rail {
    position: relative;
  }

  /* The rail: one continuous dashed thread from this thumbnail's bottom edge all the way to
     the next one's top edge — not a short fixed-height stub. `top` + `bottom` (no `height`)
     stretches it to fill whatever `.stage-rail` actually is this row, and `.stage-rail` itself
     stretches to the row's full height (CSS grid's default `align-items: stretch`), which is
     set by `.stage-body` — the taller sibling whenever a description runs to 2-3 lines. A
     fixed height here (the earlier version) left a visible gap once the row grew taller than
     the thumbnail, which is exactly the "disconnected dashes" the user flagged from a
     screenshot. None after the last stage. */
  .stage:not(:last-child) .stage-rail::after {
    content: '';
    position: absolute;
    top: 76px;
    bottom: 0;
    left: 50%;
    width: 0;
    border-left: 1px dashed var(--c-raw-umber);
  }

  .stage-thumb {
    position: relative;
    z-index: 1;
    width: 76px;
    height: 76px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--c-warm-oat);
    border: 3px solid var(--color-bg);
  }

  .stage-thumb :global(picture),
  .stage-thumb :global(.stage-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stage-thumb :global(.stage-img) {
    object-fit: cover;
  }

  .stage-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--c-warm-oat);
    background-image:
      repeating-linear-gradient(0deg, rgb(107 88 68 / 0.1) 0 2px, transparent 2px 6px),
      repeating-linear-gradient(90deg, rgb(107 88 68 / 0.08) 0 2px, transparent 2px 6px);
  }

  .stage-body {
    position: relative;
    min-width: 0;
    padding-bottom: var(--space-6);
  }

  .stage:last-child .stage-body {
    padding-bottom: 0;
  }

  .stage-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.5rem;
    padding: 0 var(--space-2);
    margin-bottom: var(--space-1);
    border-radius: var(--radius);
    background: var(--c-warm-oat);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--color-accent-text);
  }

  .stage-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-serif);
    font-size: var(--fs-card-title);
    font-weight: 600;
    line-height: var(--lh-heading);
    color: var(--color-text);
  }

  .stage-preview {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }

  .stage-preview :global(.claim-label) {
    margin-left: var(--space-1);
  }

  @media (min-width: 40rem) {
    .stage {
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: var(--space-5);
    }

    .stage-thumb {
      width: 96px;
      height: 96px;
    }

    .stage:not(:last-child) .stage-rail::after {
      top: 96px;
    }
  }
</style>
