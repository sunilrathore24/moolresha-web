---
// Site header + primary nav. Six real routes: Home, Our Journey, Design Lab,
// Journal & Research, Your Voice, Our Story (redesign spec's mobile menu).
// Privacy stays footer-only. The four Hub_Pages are not linked here.
//
// Always a solid light (cream) sticky bar, on every page including the home page's hero
// carousel — deliberately NOT transparent-over-the-hero (that was the previous behaviour).
// The logo's own colours are dark (brown wordmark, muted thread tones), so they need a
// consistent light background to read well; the hero carousel's background rotates through
// several different images/colours, and a transparent header's legibility would have varied
// slide to slide. A solid bar sidesteps that entirely.
//
// Without JavaScript: desktop links are always visible; on mobile the links
// are shown stacked under the wordmark and the menu button stays hidden.
// BaseLayout sets `html.js` before first paint, so the mobile menu does not flash.
import { Image } from "astro:assets";
import { buildNavItems, isCurrentNavItem } from "../lib/launch-nav";
import logo from "../assets/brand/logo.png";

const navItems = buildNavItems();

const path = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <a href="/" class="brand">
      <Image src={logo} alt="MoolResha — Closer to the Root" width={356} height={178} />
    </a>

    <nav aria-label="Primary" class="primary-nav">
      <ul id="primary-nav" class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentNavItem(item, path) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/journal" class="search-link" data-search-toggle aria-label="Search" aria-expanded="false" aria-controls="header-search-panel">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
      </svg>
    </a>
  </div>

  {/* Starts hidden; the island reveals it and intercepts the icon's click above instead of
     following it to /journal. Without JS the icon stays a plain link to /journal — no dead
     end. Typing a design's name and pressing Enter/tapping the arrow jumps straight to that
     Concept's page (src/lib/concept-search.ts); anything that doesn't match goes home, never
     to a results/error page (explicit instruction). */}
  <div class="search-panel container" id="header-search-panel" data-search-panel hidden>
    <form class="search-form" data-search-form role="search">
      <label class="visually-hidden" for="header-search-input">Search designs</label>
      <input
        class="search-input"
        type="search"
        id="header-search-input"
        name="q"
        placeholder="Try &ldquo;linen shirt&rdquo; or &ldquo;cotton pant&rdquo;"
        autocomplete="off"
      />
      <button type="submit" class="search-submit" aria-label="Go">
        <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 10h13M11 5l5 5-5 5" />
        </svg>
      </button>
    </form>
  </div>
</header>

<style>
  .site-header {
    --header-fg: var(--color-text);
    position: sticky;
    top: 0;
    z-index: 30;
    width: 100%;
    color: var(--header-fg);
    background: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-end: auto;
    color: inherit;
    text-decoration: none;
  }

  .brand :global(img) {
    display: block;
    height: 34px;
    width: auto;
  }

  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-inline-start: calc(-1 * var(--space-2));
    color: inherit;
  }

  .search-panel {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
    background: var(--color-header-bg);
  }

  .search-panel[hidden] {
    display: none;
  }

  .search-form {
    display: flex;
    gap: var(--space-2);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--c-raw-umber);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--fs-body);
  }

  .search-input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .search-submit {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--color-olive, #3b3a2b);
    color: var(--c-off-white, #faf6ef);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .search-submit:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), color var(--transition);
  }

  .nav-list a:hover,
  .nav-list a[aria-current="page"] {
    color: inherit;
    border-bottom-color: currentColor;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-inline-start: calc(-1 * var(--space-2));
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: inherit;
    cursor: pointer;
  }

  .nav-toggle-bar,
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform var(--transition), background-color var(--transition);
  }

  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav-toggle-bar::before {
    top: -7px;
  }
  .nav-toggle-bar::after {
    top: 7px;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar {
    background: transparent;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar::before {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile / narrow desktop ----
     Threshold raised from 40rem (640px) to 56.25rem (900px): at in-between widths (roughly
     640-870px — a common tablet/narrow-laptop window size) the full 6-item nav + logo + search
     doesn't fit on one line and wraps to two rows. Below this threshold, use the hamburger. */
  @media (max-width: 56.25rem) {
    /* Logo centered between the hamburger and search icon (reference layout). */
    .brand {
      flex: 1;
      justify-content: center;
      margin-inline-end: 0;
    }

    /* Without JS: links stacked under the wordmark, no menu button. */
    .header-inner {
      flex-wrap: wrap;
      gap: 0 var(--space-5);
    }

    .primary-nav {
      flex-basis: 100%;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    /* With JS: hamburger top-right, links in a full-width panel. */
    :global(html.js) .header-inner {
      flex-wrap: nowrap;
    }

    :global(html.js) .primary-nav {
      flex-basis: auto;
    }

    :global(html.js) .nav-toggle {
      display: inline-flex;
    }

    :global(html.js) .nav-list {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      padding: var(--space-2) var(--space-5) var(--space-5);
      background: var(--color-header-bg);
      color: var(--color-text);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-soft);
    }

    :global(html.js) .nav-list.open {
      display: flex;
    }

    :global(html.js) .nav-list a {
      display: flex;
      width: 100%;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
      font-size: 1.05rem;
    }

    :global(html.js) .nav-list a:hover,
    :global(html.js) .nav-list a[aria-current="page"] {
      color: var(--color-accent-text);
      border-bottom-color: var(--color-border);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  const list = document.getElementById("primary-nav");

  if (header && toggle && list) {
    const setOpen = (open: boolean) => {
      list.classList.toggle("open", open);
      header.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!list.classList.contains("open")));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && list.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Following an in-page anchor closes the panel.
    list.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) setOpen(false);
    });

    // Back on desktop width the panel state no longer applies. Keep in sync with the
    // 56.25rem breakpoint in the <style> block above.
    matchMedia("(min-width: 56.3125rem)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<script>
  import { initHeaderSearch } from "../islands/header-search";
  initHeaderSearch();
</script>
