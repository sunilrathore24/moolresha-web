---
// Site header + primary nav (Requirement 2.4). Links go only to Launch_Page
// section anchors, the Journal and the Privacy_Notice. The four Hub_Pages are
// not linked here. Anchors use "/#id" so they work from every page.
//
// Home page: the bar sits over the full-viewport hero, transparent with white
// text on a soft dark gradient. Once the hero has scrolled out of view it turns
// into a solid cream sticky bar (IntersectionObserver toggles `.is-solid`).
// Other pages: solid and sticky from the start.
//
// Without JavaScript: desktop links are always visible; on mobile the links
// are shown stacked under the wordmark and the menu button stays hidden.
// BaseLayout sets `html.js` before first paint, so the mobile menu does not flash.
import { SITE } from "../content/config/site";
import { buildNavItems, isCurrentNavItem } from "../lib/launch-nav";

// The Journal link always points at the Journal index (src/pages/journal.astro),
// which lists every published article; it no longer depends on one existing.
const navItems = buildNavItems({ journalHref: SITE.journalHref });

const path = Astro.url.pathname;
const overlay = path === "/";
---

<header class:list={["site-header", { "is-overlay": overlay }]} data-site-header>
  <div class="container header-inner">
    <a href="/" class="brand">MoolResha</a>

    <nav aria-label="Primary" class="primary-nav">
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>

      <ul id="primary-nav" class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentNavItem(item, path) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    --header-fg: var(--color-text);
    position: sticky;
    top: 0;
    z-index: 30;
    width: 100%;
    color: var(--header-fg);
    background: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition);
  }

  /* ---- Over the hero (home page) ---- */
  .site-header.is-overlay {
    --header-fg: var(--color-on-hero);
    position: absolute;
    inset: 0 0 auto 0;
    background: linear-gradient(180deg, rgb(var(--hero-scrim) / 0.55) 0%, rgb(var(--hero-scrim) / 0) 100%);
    border-bottom-color: transparent;
  }

  /* With JS the overlay bar stays on screen while scrolling. */
  :global(html.js) .site-header.is-overlay {
    position: fixed;
  }

  /* Without JS on a phone the stacked links would cover the hero text, so the bar is solid and in flow. */
  @media (max-width: 40rem) {
    :global(html:not(.js)) .site-header.is-overlay {
      --header-fg: var(--color-text);
      position: relative;
      background: var(--color-header-bg);
      border-bottom-color: var(--color-border);
    }
  }

  .site-header.is-overlay.is-solid,
  .site-header.is-overlay.menu-open {
    --header-fg: var(--color-text);
    background: var(--color-header-bg);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .site-header.is-overlay:not(.is-solid):not(.menu-open) :focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), color var(--transition);
  }

  .nav-list a:hover,
  .nav-list a[aria-current="page"] {
    color: inherit;
    border-bottom-color: currentColor;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-inline-end: calc(-1 * var(--space-2));
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: inherit;
    cursor: pointer;
  }

  .nav-toggle-bar,
  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform var(--transition), background-color var(--transition);
  }

  .nav-toggle-bar::before,
  .nav-toggle-bar::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .nav-toggle-bar::before {
    top: -7px;
  }
  .nav-toggle-bar::after {
    top: 7px;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar {
    background: transparent;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar::before {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-bar::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile ---- */
  @media (max-width: 40rem) {
    /* Without JS: links stacked under the wordmark, no menu button. */
    .header-inner {
      flex-wrap: wrap;
      gap: 0 var(--space-5);
    }

    .primary-nav {
      flex-basis: 100%;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    /* With JS: hamburger top-right, links in a full-width panel. */
    :global(html.js) .header-inner {
      flex-wrap: nowrap;
    }

    :global(html.js) .primary-nav {
      flex-basis: auto;
    }

    :global(html.js) .nav-toggle {
      display: inline-flex;
    }

    :global(html.js) .nav-list {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      padding: var(--space-2) var(--space-5) var(--space-5);
      background: var(--color-header-bg);
      color: var(--color-text);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-soft);
    }

    :global(html.js) .nav-list.open {
      display: flex;
    }

    :global(html.js) .nav-list a {
      display: flex;
      width: 100%;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--color-border);
      font-size: 1.05rem;
    }

    :global(html.js) .nav-list a:hover,
    :global(html.js) .nav-list a[aria-current="page"] {
      color: var(--color-accent-text);
      border-bottom-color: var(--color-border);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  const list = document.getElementById("primary-nav");

  if (header && toggle && list) {
    const setOpen = (open: boolean) => {
      list.classList.toggle("open", open);
      header.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!list.classList.contains("open")));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && list.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Following an in-page anchor closes the panel.
    list.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) setOpen(false);
    });

    // Back on desktop width the panel state no longer applies.
    matchMedia("(min-width: 40.0625rem)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });

    // Home page: solid bar once the hero has left the viewport.
    const hero = document.getElementById("hero");
    if (header.classList.contains("is-overlay") && hero && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([entry]) => header.classList.toggle("is-solid", !entry?.isIntersecting),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
      );
      io.observe(hero);
    }
  }
</script>
