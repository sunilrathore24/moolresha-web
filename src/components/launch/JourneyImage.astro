---
/**
 * Photo for one cotton journey stop, or for a supporting image elsewhere on the launch page.
 * Picks the file in src/assets/journey/ by key and renders an AVIF/WebP <Picture>.
 * Pass alt="" for decorative use.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { JourneyImageKey } from '../../lib/journey-stops';
import field from '../../assets/journey/field.jpg';
import ginning from '../../assets/journey/ginning.png';
import spinning from '../../assets/journey/spinning.png';
import weaving from '../../assets/journey/weaving.png';
import processing from '../../assets/journey/processing.png';
import stitching from '../../assets/journey/stitching.png';
import warehousing from '../../assets/journey/warehousing.jpg';
import retail from '../../assets/journey/retail.jpg';

const IMAGES: Record<JourneyImageKey, ImageMetadata> = {
  field,
  ginning,
  spinning,
  weaving,
  processing,
  stitching,
  warehousing,
  retail,
};

interface Props {
  imageKey: JourneyImageKey;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
}

const { imageKey, alt, sizes, widths = [320, 480, 720], class: className } = Astro.props;
const image = IMAGES[imageKey];
---

<Picture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  width={image.width}
  height={image.height}
  loading="lazy"
  decoding="async"
  class={className}
  data-journey-image={imageKey}
/>
