---
/**
 * Homepage navigation cards (redesign spec §6, Section 4): a compact 2-column grid
 * pointing at the site's four other main areas, now that each has its own page.
 * Pure links — no forms, no islands.
 *
 * Beautified 2026-11, per explicit instruction ("one icon, centre-line text, some coloured
 * tiles from our design system"): each card gets a small stroke icon in a light-tinted
 * colour badge, centred title/description, and a centred arrow — the colour per card comes
 * from the site's own existing palette tokens (terracotta, sage, clay, indigo dusk), not new
 * ones invented for this.
 */
interface Card {
  title: string;
  description: string;
  href: string;
  tone: 'terracotta' | 'sage' | 'clay' | 'indigo';
  icon: string;
}

/** Raw inner SVG markup, stroke-based, matching the site's existing minimal icon style. */
const ICONS: Record<string, string> = {
  journey: '<path d="M4 20c3-6 5-6 8-12s5-6 8 0" /><circle cx="4" cy="20" r="1.1" fill="currentColor" stroke="none" /><circle cx="20" cy="8" r="1.1" fill="currentColor" stroke="none" />',
  price: '<path d="M12.6 4H6.5A1.5 1.5 0 0 0 5 5.5v6.1c0 .4.16.78.44 1.06l8.4 8.4c.58.58 1.52.58 2.1 0l5.06-5.06c.58-.58.58-1.52 0-2.1l-8.4-8.4A1.5 1.5 0 0 0 12.6 4Z" /><circle cx="9" cy="9" r="1.1" fill="currentColor" stroke="none" />',
  journal: '<path d="M4 5.5c2-1 5-1 8 .5v13c-3-1.5-6-1.5-8-.5Z" /><path d="M20 5.5c-2-1-5-1-8 .5v13c3-1.5 6-1.5 8-.5Z" />',
  voice: '<path d="M4 6.5h16a1 1 0 0 1 1 1V15a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1Z" />',
};

const CARDS: Card[] = [
  { title: 'The Journey', description: 'Field to wardrobe.', href: '/journey', tone: 'sage', icon: ICONS.journey! },
  { title: 'Price Transparency', description: 'Cost of a quality shirt.', href: '/journey/pricing', tone: 'terracotta', icon: ICONS.price! },
  { title: 'Journal & Research', description: 'Studies and insights.', href: '/journal', tone: 'indigo', icon: ICONS.journal! },
  { title: 'Your Voice', description: 'Share your opinion.', href: '/your-voice', tone: 'clay', icon: ICONS.voice! },
];
---

<section class="section" data-section="nav-cards" id="nav-cards" aria-labelledby="nav-cards-h">
  <h2 id="nav-cards-h" class="visually-hidden">More about MoolResha</h2>
  <ul class="nav-cards">
    {
      CARDS.map((c) => (
        <li>
          <a class="nav-card" href={c.href}>
            <span class={`nav-card-icon tone-${c.tone}`} aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
            </span>
            <span class="nav-card-title">{c.title}</span>
            <span class="nav-card-desc">{c.description}</span>
            <span class="nav-card-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .nav-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 148px;
    padding: var(--space-5) var(--space-3);
    background: var(--color-card, #fbf7f0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 14px);
    text-decoration: none;
    color: var(--color-text);
    text-align: center;
  }

  .nav-card:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .nav-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-3);
    border-radius: 50%;
    flex: none;
  }

  /* Light tints of existing palette tokens — not new colours, just a quieter fill behind
     each icon than the full-strength accent would give. */
  .nav-card-icon.tone-terracotta {
    background: rgb(181 113 79 / 0.14);
    color: var(--c-terracotta);
  }

  .nav-card-icon.tone-sage {
    background: rgb(154 167 140 / 0.22);
    color: var(--c-sage);
  }

  .nav-card-icon.tone-clay {
    background: rgb(192 138 106 / 0.18);
    color: var(--c-clay);
  }

  .nav-card-icon.tone-indigo {
    background: rgb(63 70 104 / 0.14);
    color: #3f4668; /* Indigo Dusk — same hex as the Palette_Colour swatch (no CSS token for it) */
  }

  .nav-card-title {
    font-family: var(--font-serif);
    font-size: var(--fs-card-title);
    font-weight: 600;
    line-height: var(--lh-heading);
  }

  .nav-card-desc {
    margin-top: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  .nav-card-arrow {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--fs-body);
    color: var(--color-accent-text);
  }
</style>
