---
/**
 * Price_Layers (Requirements 6.1 to 6.6, 21.4). Renders src/content/price-layers/price-layers.yaml:
 * the nine layers in the schema's fixed order, each with its name and one-line explanation, then
 * the literal launch promise and the GST context as a Fact_Element.
 *
 * This component prints no amount, percentage, subtotal or total. The only figures in the
 * section sit inside the GST fact (Content_Check CC-08, CC-09). Nothing here is an offer, buy
 * price or discount (Requirement 6.5).
 * The colour band has one EQUAL-width segment per layer and is only a colour key: the caption
 * says the colours are not to scale. The legend and the list carry every name as text, so
 * colour is never the only signal. Layer numbers are CSS counters, not page text.
 *
 * Layout: a "mini hero" banner carries the eyebrow, heading and intro over the fabric photo.
 * The photo stays plain and uncovered in its upper portion; a gradient scrim darkens only the
 * lower portion the text sits in (same near-black scrim family as the page Hero, but a plain
 * two-stop fade rather than Hero's uniform wash, since the top here is meant to read as a clean,
 * undimmed photo rather than a backdrop). The rest of the content (colour band, legend, layer
 * list, launch promise, GST fact) sits below the banner on the normal page background, so a long
 * list never has to fight a sidebar or sit on top of a photo it would make hard to read.
 */
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import FactText from './FactText.astro';
import LastUpdated from './LastUpdated.astro';
import { journeyImage, pictureWidths } from '../../lib/journey-images';

const entry = await getEntry('price-layers', 'price-layers');
if (!entry) {
  throw new Error('Missing price-layers entry. Add src/content/price-layers/price-layers.yaml.');
}
const { layers, launchPromise, gstFactId } = entry.data;
/** One tone per layer, in order (nine tokens); cycles if the schema ever allows more. */
const TONES = [
  'terracotta-deep',
  'terracotta',
  'clay',
  'terracotta-light',
  'flax',
  'oat',
  'sage',
  'olive',
  'umber',
] as const;
const tone = (i: number) => TONES[i % TONES.length];
const photo = journeyImage('fabric-roll');
---

<section class="price-layers" data-section="price-layers" id="price-layers" aria-labelledby="price-layers-h">
  <div class="pl-banner">
    <Picture
      src={photo}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={pictureWidths(photo, [480, 768, 1080, 1280])}
      sizes="(min-width: 72rem) 70rem, 100vw"
      width={photo.width}
      height={photo.height}
      loading="lazy"
      decoding="async"
      class="pl-banner-img"
    />
    <div class="pl-banner-scrim" aria-hidden="true"></div>
    <div class="pl-banner-content">
      <p class="pl-label eyebrow">02 — Understanding the price</p>
      <h2 id="price-layers-h">What goes into the price of a shirt?</h2>
      <p class="pl-intro">These are the layers that make up the price of a garment, in the order they usually appear.</p>
    </div>
  </div>

  <div class="pl-body">
    <figure class="pl-band">
      <div class="pl-band-track" aria-hidden="true">
        {layers.map((_, i) => <span class={`pl-band-seg tone-${tone(i)}`} />)}
      </div>
      <figcaption>Colours only identify the layers. They are not to scale.</figcaption>
    </figure>

    <ul class="pl-legend" aria-label="Colour key for the layers">
      {
        layers.map((layer, i) => (
          <li>
            <span class={`pl-swatch tone-${tone(i)}`} aria-hidden="true" />
            {layer.name}
          </li>
        ))
      }
    </ul>

    <ol class="layers" id="price-layer-list" data-price-layers>
      {
        layers.map((layer, i) => (
          <li data-layer={layer.id}>
            <span class={`layer-tone tone-${tone(i)}`} aria-hidden="true" />
            <strong class="layer-name">{layer.name}</strong>
            <span class="layer-explanation">{layer.explanation}</span>
            {i === 1 && (
              <button
                type="button"
                class="layers-more"
                data-layers-more
                hidden
                aria-expanded="false"
                aria-controls="price-layer-list"
              >
                Show all {layers.length} layers
              </button>
            )}
          </li>
        ))
      }
    </ol>

    <p class="launch-promise">{launchPromise}</p>

    <p class="gst-context"><FactText id={gstFactId} /></p>

    <LastUpdated factIds={[gstFactId]} />
  </div>
</section>

<style>
  .price-layers {
    max-width: var(--wide-width);
    margin: 0 auto;
    /* No top padding: the banner sits flush with the section's top edge, full width. */
    padding: 0 var(--space-4) var(--space-section);
  }

  /* ---- Banner: a "mini hero". Crisp photo up top, a gradient scrim darkens only the lower
     band the heading and intro sit in. Near-black scrim colour matches the page Hero's. ---- */
  .pl-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: clamp(18rem, 48vw, 26rem);
    border-radius: var(--radius-card);
    background: var(--c-warm-oat);
  }

  .pl-banner :global(.pl-banner-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pl-banner-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 22%,
      rgb(20 17 12 / 0.48) 40%,
      rgb(20 17 12 / 0.75) 65%,
      rgb(20 17 12 / 0.92) 100%
    );
  }

  .pl-banner-content {
    position: relative;
    z-index: 1;
    padding: var(--space-6) var(--space-5);
    color: var(--color-on-hero);
  }

  .pl-label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-hero);
  }

  .pl-banner-content h2 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-serif);
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: var(--lh-tight);
    letter-spacing: -0.015em;
    color: var(--color-on-hero);
    text-shadow: 0 1px 24px rgb(20 17 12 / 0.35);
  }

  .pl-intro {
    margin: var(--space-3) 0 0;
    max-width: 34rem;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-on-hero);
  }

  @media (min-width: 56rem) {
    .pl-banner-content {
      max-width: 40rem;
      padding: var(--space-8);
    }
  }

  /* ---- Body: the rest of the content, on the normal page background ---- */
  .pl-body {
    margin-top: var(--space-8);
    min-width: 0;
  }

  /* ---- Tones (nine tokens) ---- */
  .tone-terracotta-deep {
    background: var(--c-terracotta-deep);
  }

  .tone-terracotta {
    background: var(--c-terracotta);
  }

  .tone-clay {
    background: var(--c-clay);
  }

  .tone-terracotta-light {
    background: var(--c-terracotta-light);
  }

  .tone-flax {
    background: var(--c-flax-beige);
  }

  .tone-oat {
    background: var(--c-warm-oat);
  }

  .tone-sage {
    background: var(--c-sage);
  }

  .tone-olive {
    background: var(--c-olive);
  }

  .tone-umber {
    background: var(--c-raw-umber);
  }

  /* ---- Equal-segment colour band ---- */
  .pl-band {
    margin: 0 0 var(--space-4);
  }

  .pl-band-track {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 3px;
    height: 1.25rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .pl-band-seg {
    display: block;
    box-shadow: inset 0 0 0 1px rgb(44 38 32 / 0.08);
  }

  .pl-band figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }

  /* ---- Legend ---- */
  .pl-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .pl-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pl-swatch {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgb(44 38 32 / 0.12);
  }

  /* ---- Numbered layer list ---- */
  .layers {
    counter-reset: price-layer;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .layers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .layers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .layers li {
    position: relative;
    counter-increment: price-layer;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-5);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  .layers li::before {
    content: counter(price-layer, decimal-leading-zero);
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    line-height: 1.2;
    color: var(--color-accent-text);
  }

  .layer-tone {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .layer-name {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    font-weight: 500;
    line-height: var(--lh-heading);
  }

  .layer-explanation {
    display: block;
    color: var(--color-text-muted);
  }

  .launch-promise {
    margin: 0 0 var(--space-4);
    padding: var(--space-4) 0 var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent);
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.3;
    color: var(--color-text);
  }

  .gst-context {
    margin: 0 0 var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--color-text);
  }

  /* ---- "Show more" (src/islands/price-layers.ts), mobile only: nine stacked tiles made a long
     vertical run on narrow screens. Without JS, or at 40rem and up (where .layers is already
     multi-column), `.layers` never gets `data-collapsed` and every tile renders exactly as
     before - this whole block only ever hides content that's also reachable without it. ---- */
  .layers-more {
    display: none;
  }

  @media (max-width: 39.99rem) {
    .layers li {
      transition:
        max-height 420ms ease-out,
        opacity 320ms ease-out,
        padding 420ms ease-out,
        margin 420ms ease-out,
        border-color 420ms ease-out;
    }

    /* Tiles after the second: collapsed to nothing. */
    .layers[data-collapsed] li:nth-child(n + 3) {
      max-height: 0;
      margin: 0;
      padding-top: 0;
      padding-bottom: 0;
      border-color: transparent;
      opacity: 0;
    }

    /* The second tile: clipped to about half, with the "Show more" overlay sitting on the
       cut-off half, fading up from the tile's own surface colour so it reads as a backdrop,
       not a second box. */
    .layers[data-collapsed] li:nth-child(2) {
      max-height: 5.25rem;
    }

    .layers[data-collapsed] .layers-more {
      display: flex;
    }

    .layers-more {
      position: absolute;
      inset: auto 0 0 0;
      height: 70%;
      align-items: flex-end;
      justify-content: center;
      margin: 0;
      padding: 0 0 var(--space-3);
      background: linear-gradient(180deg, transparent 0%, var(--color-surface) 65%);
      border: none;
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      font-weight: 600;
      color: var(--color-accent-text);
      cursor: pointer;
    }

    .layers-more:focus-visible {
      outline: 3px solid var(--color-focus);
      outline-offset: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layers li {
      transition: none;
    }
  }
</style>

<script>
  import '../../islands/price-layers';
</script>
