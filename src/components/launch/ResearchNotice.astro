---
// Research notice (Requirement 1.3). Sits in the hero, directly below the call
// to action, as small light text over the hero overlay. Plain copy, not a Fact:
// no Claim_Label, no data-fact-id, no data-section.
---

<aside class="research-notice" aria-labelledby="research-notice-h">
  <p id="research-notice-h" class="notice-title">A research project, not a shop</p>
  <p class="notice-body">
    Nothing on this site is for sale. MoolResha is collecting opinions on
    design ideas before anything is made.
  </p>
</aside>

<style>
  /* White on the hero overlay: at least 5.19:1 against the brightest frame pixel. */
  .research-notice {
    max-width: 30rem;
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid rgb(227 181 151 / 0.8);
    color: var(--color-on-hero);
  }

  .notice-title {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .notice-body {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
</style>
