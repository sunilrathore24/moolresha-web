---
/**
 * One "Beyond the label" problem card: a decorative photo, a plain heading, a short
 * non-numeric framing line, one sourced Fact (inside FactText, so no free-standing
 * number ever appears — CC-09), and a link into the matching Journal article for depth.
 * Mirrors Trend_Card's shape and CSS rather than inventing a new pattern.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FactText from './FactText.astro';
import { pictureWidths } from '../../lib/journey-images';

interface Props {
  heading: string;
  /** One short sentence, no numbers or claims of its own. */
  intro: string;
  factId: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Journal article slug this card links into for the full story. */
  articleSlug: string;
}

const { heading, intro, factId, image, imageAlt, articleSlug } = Astro.props;
---

<li class="bl-card">
  <div class="bl-photo">
    <Picture
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={pictureWidths(image, [480, 720, 960])}
      sizes="(min-width: 60rem) 32rem, 92vw"
      width={image.width}
      height={image.height}
      loading="lazy"
      decoding="async"
      class="bl-img"
    />
  </div>
  <div class="bl-body">
    <h3>{heading}</h3>
    <p class="bl-intro">{intro}</p>
    <div class="bl-fact">
      <FactText id={factId} />
    </div>
    <a class="bl-link" href={`/article/${articleSlug}`}>
      <span>Read the full story</span>
      <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="16" height="16">
        <path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</li>

<style>
  .bl-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }

  .bl-photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--c-warm-oat);
  }

  .bl-photo :global(picture),
  .bl-photo :global(.bl-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .bl-photo :global(.bl-img) {
    object-fit: cover;
  }

  .bl-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
  }

  h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: var(--lh-heading);
    color: var(--color-text);
  }

  .bl-intro {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }

  .bl-fact {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }

  .bl-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-accent-text);
    text-decoration: none;
  }

  .bl-link svg {
    transition: transform var(--transition);
  }

  .bl-link:hover svg {
    transform: translateX(3px);
  }
</style>
