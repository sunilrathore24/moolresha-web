---
// Hero (Requirements 1.1, 1.2, 1.4, 1.5, 2.3).
// Full-bleed, full-viewport cotton field at sunrise: a still frame (<Picture>, the LCP image and
// the no-JS view) with a muted looping video laid over it. One wordmark, one headline, one
// supporting line and one call to action. Put <ResearchNotice /> in the default slot so it sits
// directly below the call to action (Requirement 1.3).
//
// The video never plays without src/islands/hero-video.ts: that island applies the
// reduced-motion and Save-Data policy, waits for `load`, and reveals the pause/play toggle
// (WCAG 2.2.2). Without JS the still frame shows and nothing moves.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { HERO_PHOTO_ALT, HERO_VIDEO, pickHeroPhotoKey, toggleState } from '../../lib/hero-photo';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/hero/*.{jpg,jpeg,webp,png}',
  { eager: true },
);
const key = pickHeroPhotoKey(Object.keys(modules));
const photo = key ? modules[key]?.default : undefined;
const initialToggle = toggleState(true);
---

<section class="hero" data-section="hero" id="hero" aria-labelledby="hero-h">
  <div class="hero-media">
    {
      photo ? (
        <Picture
          src={photo}
          alt={HERO_PHOTO_ALT}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1600, 1920]}
          sizes="100vw"
          width={photo.width}
          height={photo.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero-photo"
        />
      ) : (
        <div class="hero-photo hero-placeholder" role="img" aria-label={HERO_PHOTO_ALT} />
      )
    }
    <video
      class="hero-video"
      data-hero-video
      muted
      playsinline
      loop
      preload="none"
      poster={HERO_VIDEO.poster}
      width={HERO_VIDEO.width}
      height={HERO_VIDEO.height}
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
    >
      <source src={HERO_VIDEO.src} type={HERO_VIDEO.type} />
    </video>
    <div class="hero-overlay" aria-hidden="true"></div>
  </div>

  <svg
    class="hero-thread"
    aria-hidden="true"
    focusable="false"
    viewBox="0 0 1440 320"
    preserveAspectRatio="none"
  >
    <path
      d="M-20 250 C 180 170, 330 300, 540 220 S 900 90, 1100 170 S 1360 260, 1460 140"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <div class="container hero-inner">
    <p class="wordmark">MoolResha</p>
    <h1 id="hero-h">Why does a simple cotton shirt cost so much? We traced it.</h1>
    <p class="support">Explore the journey from fibre to fabric to something you wear.</p>

    <p class="cta-row">
      <a class="cta" href="#concepts">
        <span>Explore the designs</span>
        <svg class="cta-arrow" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="20" height="20">
          <path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </p>
    <p class="cta-hint">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="14" height="14">
        <path
          d="M10 2l1.9 5.6L17.5 9l-5.6 1.9L10 16.5 8.1 10.9 2.5 9l5.6-1.4L10 2z"
          fill="currentColor"
        />
      </svg>
      Share your view early — founding supporters get first access and a launch perk.
    </p>

    <slot />
  </div>

  <button
    type="button"
    class="hero-video-toggle"
    data-hero-video-toggle
    aria-label={initialToggle.label}
    aria-pressed={initialToggle.pressed}
    data-state="paused"
    hidden
  >
    <svg class="icon-pause" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18">
      <path d="M6.5 4.5v11M13.5 4.5v11" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
    </svg>
    <svg class="icon-play" aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18">
      <path d="M7 4.8v10.4L15.5 10z" fill="currentColor" />
    </svg>
  </button>
</section>

<script>
  import '../../islands/hero-video';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    color: var(--color-on-hero);
    background: var(--c-ink);
  }

  .hero-media,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    z-index: -1;
  }

  .hero-media :global(picture),
  .hero-photo,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero-placeholder {
    background: linear-gradient(180deg, var(--c-raw-umber), var(--c-olive));
  }

  /* The video stays invisible until it plays, so the still frame is what you see first. */
  .hero-video {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .hero-video[data-playing] {
    opacity: 1;
  }

  .hero-overlay {
    background: var(--hero-overlay);
  }

  .hero-thread {
    position: absolute;
    inset: auto 0 18% 0;
    z-index: 0;
    width: 100%;
    height: clamp(8rem, 22vw, 20rem);
    color: rgb(227 181 151 / 0.55);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: clamp(var(--space-8), 10vh, var(--space-12));
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-on-hero);
  }

  h1 {
    max-width: 16ch;
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    font-weight: 400;
    color: var(--color-on-hero);
    text-shadow: 0 1px 24px rgb(var(--hero-scrim) / 0.35);
  }

  .support {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    color: var(--color-on-hero);
  }

  .cta-row {
    margin-top: var(--space-2);
  }

  /* A directional teaser only (no exact percentage or headcount promised here — that detail,
     and its full non-binding wording, lives with the actual email capture in InterestForm.astro).
     Just enough to make opening a design feel worth it. */
  .cta-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--c-terracotta-light);
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .cta-hint svg {
    flex: none;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent-text);
    color: var(--c-off-white);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: background-color var(--transition);
  }

  .cta:hover {
    background: var(--c-raw-umber);
    color: var(--c-off-white);
  }

  .cta-arrow {
    flex: none;
    transition: transform var(--transition);
  }

  .cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  .hero :focus-visible {
    outline-color: var(--color-focus-on-dark);
  }

  .hero-video-toggle {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 50%;
    background: rgb(var(--hero-scrim) / 0.55);
    color: var(--color-on-hero);
    cursor: pointer;
    transition: background-color var(--transition);
  }

  .hero-video-toggle[hidden] {
    display: none;
  }

  .hero-video-toggle:hover {
    background: rgb(var(--hero-scrim) / 0.8);
  }

  .hero-video-toggle[data-state='playing'] .icon-play,
  .hero-video-toggle[data-state='paused'] .icon-pause {
    display: none;
  }

  @media (max-width: 40rem) {
    .hero-inner {
      padding-bottom: calc(var(--space-8) + 44px);
    }
  }
</style>
