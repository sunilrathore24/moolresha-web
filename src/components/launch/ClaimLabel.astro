---
/**
 * Claim_Label tag (Requirement 3.1). The label text is always rendered, so colour
 * is never the only signal (Requirement 21.4).
 */
import type { ClaimLabelText } from '../../lib/fact-schema';

interface Props {
  label: ClaimLabelText;
}

const { label } = Astro.props;
---

<span class="claim-label" data-claim-label={label}>{label}</span>

<style>
  /* A quiet inline attribution, not a UI chip: no box, no border, no background. */
  .claim-label {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 600;
    font-style: italic;
    line-height: var(--lh-body);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
