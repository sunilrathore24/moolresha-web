---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Adds `<meta name="robots" content="noindex">`. Used by the Hub_Pages. */
  noindex?: boolean;
}

const {
  title,
  description = "Know what you wear. Learn to read any clothing label, judge any fabric, and choose for yourself.",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Social share preview image. Degrades to no image (not a broken-image icon) on any
// platform until /public/images/og-image.jpg is added — see docs/image-prompts.md.
const ogImage = new URL("/images/og-image.jpg", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <!-- Google Search's favicon crawler only supports ICO/PNG/APNG/GIF/WebP, not SVG-only
         (https://developers.google.com/search/docs/appearance/favicon-in-search) — this is why
         Search was showing a generic globe/page icon instead of the real one. `favicon.ico`
         (16/32/48, PNG-in-ICO) covers Search and any client that still auto-probes /favicon.ico
         directly; the SVG stays first for modern browser tabs, which prefer a vector icon when
         offered one; the explicit PNG sizes and the manifest's android-chrome icons cover
         everything else (iOS home-screen, Android/PWA, older browsers). All generated from the
         one favicon.svg via scripts/generate-favicons.mjs — regenerate from there if the source
         SVG ever changes, don't hand-edit the PNGs/ICO. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Marks scripting as available before first paint, so the header can switch to its
         JS layout (fixed overlay bar, mobile menu button) without a flash. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Open Graph (expanded into full SEO in a later increment) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
