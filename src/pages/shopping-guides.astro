---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticlesByCategory } from "../lib/articles";

const articles = await getArticlesByCategory("Shopping Intelligence");
---

<BaseLayout
  title="Guides — MoolResha"
  description="Practical shopping checklists: what to look for, feel for, and ask before you buy."
>
  <section class="hub container">
    <div class="prose">
      <p class="eyebrow">Shopping Guides</p>
      <h1>What to check before you buy.</h1>
      <p class="lede">
        Practical checklists for shopping in-store and online — what to look
        for, what to feel for, and what to ask, so you buy with confidence.
      </p>
    </div>

    {
      articles.length > 0 ? (
        <ul class="hub-grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="soon">Guides are being written. Check back soon.</p>
      )
    }

    <p class="back"><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-10);
  }
  .eyebrow {
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    margin-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .soon {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .back {
    margin-top: var(--space-8);
  }
</style>
