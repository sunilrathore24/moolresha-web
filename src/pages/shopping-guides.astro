---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubHero from "../components/HubHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticlesByCategory } from "../lib/articles";

const articles = await getArticlesByCategory("Shopping Intelligence");
---

<BaseLayout
  title="Guides — MoolResha"
  description="Practical shopping checklists: what to look for, feel for, and ask before you buy."
>
  <HubHero
    eyebrow="Shopping Guides"
    title="What to check before you buy."
    lede="Practical checklists for shopping in-store and online — what to look for, what to feel for, and what to ask, so you buy with confidence."
    image="/images/hub-shopping-guides.webp"
  />

  <section class="hub container">
    {
      articles.length > 0 ? (
        <ul class="hub-grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="soon">Guides are being written. Check back soon.</p>
      )
    }

    <p class="back"><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-8) var(--space-10);
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .soon {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .back {
    margin-top: var(--space-8);
  }
</style>
