---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubHero from "../components/HubHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticlesByCategory } from "../lib/articles";

const articles = await getArticlesByCategory("Comparisons");
---

<BaseLayout
  title="Comparisons — MoolResha"
  description="Linen vs cotton, pure vs blend, and more — trade-offs, not winners."
>
  <HubHero
    eyebrow="Comparisons"
    title="Which is right — for you?"
    lede="Linen vs cotton. 100% linen vs a cotton-linen blend. We never crown a winner — we explain the trade-offs so you can match the fabric to your use."
    image="/images/hub-comparisons.webp"
  />

  <section class="hub container">
    {
      articles.length > 0 ? (
        <ul class="hub-grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="soon">Comparisons are being written. Check back soon.</p>
      )
    }

    <p class="back"><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-8) var(--space-10);
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .soon {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .back {
    margin-top: var(--space-8);
  }
</style>
