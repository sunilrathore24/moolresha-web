---
/**
 * Launch_Page — redesigned homepage (mobile-first premium redesign, 2026-11).
 *
 * Previously one long page holding every section (journey, pricing, all 5 concepts with
 * their feedback forms, why-it-matters, beyond-the-label, trends, frustration form, the
 * full interest form, and the results view) reached by in-page anchors. The redesign gives
 * Journey, Pricing, Designs, and Your Voice (frustration + interest + results) their own
 * dedicated pages — /journey, /journey/pricing, /designs, /your-voice — so the homepage can
 * be the compact, scannable overview the redesign spec asks for, not a single long scroll.
 *
 * WhyItMatters, BeyondTheLabel and Trends moved to /journal (2026-11, per the user's
 * reference-image review: "a lot of details which should not be there on the home page...
 * can go in other pages") — not deleted, relocated, since they fit that page's research/
 * insights framing and weren't in the 6-screen reference to begin with.
 *
 * Sections, in the order Content_Check CC-15 fixes (PAGE_SECTIONS in
 * src/content/config/allow-lists.ts): hero, design-lab, nav-cards, footer. Never add
 * a second `data-section` here.
 *
 * LaunchSignup.astro (the homepage-only "Be part of the beginning" email panel) was removed
 * 2026-11, per explicit instruction, now that Footer.astro has its own always-present email
 * signup panel on every page including this one — a second copy right above the footer's own
 * was redundant. The component file itself was deleted too (nothing else used it).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/launch/Hero.astro';
import DesignLabTeaser from '../components/launch/DesignLabTeaser.astro';
import NavCards from '../components/launch/NavCards.astro';

const title = 'MoolResha: a cotton shirt research project';
const description =
  'MoolResha is a research project, not a shop. See how a cotton shirt is made and priced, and tell us what you think of five design ideas.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <DesignLabTeaser />
  <NavCards />
</BaseLayout>

<script>
  import '../islands/events-island';
</script>
