---
/**
 * Launch_Page (Requirements 2.1, 2.2, 2.3, 22.1).
 *
 * Sections, in the order Requirement 2.1 fixes (PAGE_SECTIONS in
 * src/content/config/allow-lists.ts). Each component carries its own
 * `data-section` and an `id` equal to it, so the header anchors (/#journey,
 * /#money, /#concepts, /#results) and the Hero call to action (#concepts)
 * resolve. The footer comes from BaseLayout. Never add a second `data-section`
 * here (Content_Check CC-15).
 *
 * Order: hero, journey, money, price-layers, concepts, why, beyond-label, trends,
 * frustration, interest, results, footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/launch/Hero.astro';
import ResearchNotice from '../components/launch/ResearchNotice.astro';
import CottonJourney from '../components/launch/CottonJourney.astro';
import MoneyBreakdown from '../components/launch/MoneyBreakdown.astro';
import PriceLayers from '../components/launch/PriceLayers.astro';
import ConceptsSection from '../components/launch/ConceptsSection.astro';
import WhyItMatters from '../components/launch/WhyItMatters.astro';
import BeyondTheLabel from '../components/launch/BeyondTheLabel.astro';
import Trends from '../components/launch/Trends.astro';
import FrustrationForm from '../components/launch/FrustrationForm.astro';
import InterestForm from '../components/launch/InterestForm.astro';
import ResultsView from '../components/launch/ResultsView.astro';

const title = 'MoolResha: a cotton shirt research project';
const description =
  'MoolResha is a research project, not a shop. See how a cotton shirt is made and priced, and tell us what you think of five design ideas.';
---

<BaseLayout title={title} description={description}>
  <Hero><ResearchNotice /></Hero>
  <CottonJourney />
  <MoneyBreakdown />
  <PriceLayers />
  <ConceptsSection />
  <WhyItMatters />
  <BeyondTheLabel />
  <Trends />
  <FrustrationForm />
  <InterestForm />
  <ResultsView />
</BaseLayout>

<script>
  import '../islands/events-island';
  import '../islands/feedback-island';
  import '../islands/results-island';
  import '../islands/interest-island';
</script>
