---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubHero from "../components/HubHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticlesByCategory } from "../lib/articles";

const articles = await getArticlesByCategory("Fabric School");
---

<BaseLayout
  title="Fabric School — MoolResha"
  description="What GSM, Lea, yarn count, weave and finish actually mean — and what they don't tell you."
>
  <HubHero
    eyebrow="Fabric School"
    title="What the label really means."
    lede="100% Linen. 180 GSM. 60 Lea. Combed cotton. We break down what each spec tells you — and, just as importantly, what it leaves out."
    image="/images/hub-fabric-school.webp"
  />

  <section class="hub container">
    {
      articles.length > 0 ? (
        <ul class="hub-grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="soon">Lessons are being written. Check back soon.</p>
      )
    }

    <p class="back"><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-8) var(--space-10);
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .soon {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .back {
    margin-top: var(--space-8);
  }
</style>
