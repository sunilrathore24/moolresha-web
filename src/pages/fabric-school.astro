---
import BaseLayout from "../layouts/BaseLayout.astro";
// Pillar hub stub (Fabric School). Real articles arrive in increments 4–5.
---

<BaseLayout
  title="Fabric School — MoolResha"
  description="What GSM, Lea, yarn count, weave and finish actually mean — and what they don't tell you."
>
  <section class="hub container prose">
    <p class="eyebrow">Fabric School</p>
    <h1>What the label really means.</h1>
    <p class="lede">
      100% Linen. 180 GSM. 60 Lea. Combed cotton. We break down what each spec
      tells you — and, just as importantly, what it leaves out.
    </p>
    <p class="soon">Lessons are being written. Check back soon.</p>
    <p><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-10);
  }
  .eyebrow {
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .lede {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }
  .soon {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
</style>
