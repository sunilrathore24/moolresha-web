---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubHero from "../components/HubHero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getArticlesByCategory } from "../lib/articles";

const articles = await getArticlesByCategory("Fibre Stories");
---

<BaseLayout
  title="Fibre Stories — MoolResha"
  description="Trace each fibre from its root to the garment: linen, cotton, and more."
>
  <HubHero
    eyebrow="Fibre Stories"
    title="From the root to your wardrobe."
    lede="Every material has an origin — a plant, a field, a process. We follow each one from source to fibre to yarn to fabric to the garment you wear."
    image="/images/hub-fibre-stories.webp"
  />

  <section class="hub container">
    {
      articles.length > 0 ? (
        <ul class="hub-grid">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="soon">The first fibre stories are being written. Check back soon.</p>
      )
    }

    <p class="back"><a href="/">&larr; Back home</a></p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: var(--space-8) var(--space-10);
  }
  .hub-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .soon {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }
  .back {
    margin-top: var(--space-8);
  }
</style>
